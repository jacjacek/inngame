{
  "expo": {
    "name": "MyMovio",
    "slug": "mymovio-expo",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/mymovio/icon.png",
    "scheme": "mymovio",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.mymovio.app",
      "supportsTablet": true,
      "icon": "./assets/mymovio/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F8F3",
        "foregroundImage": "./assets/mymovio/icon.png",
        "monochromeImage": "./assets/mymovio/icon.png"
      },
      "package": "com.mymovio.app",
      "predictiveBackGestureEnabled": true,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/mymovio/icon.png",
      "themeColor": "#F7F8F3"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F8F3",
          "image": "./assets/mymovio/icon.png",
          "imageWidth": 112
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    }
  }
}
